{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "jsx": "react-jsx", "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["./client/src/*"] }
  },
  "include": ["client/**/*.ts", "client/**/*.tsx", "shared/**/*.ts", "vite.config.ts"]
}
