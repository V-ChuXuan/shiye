{
  "name": "shiye",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "个人本地微信公众号归档与阅读应用",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5179",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "test": "tsx --test \"test/*.test.ts\"",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:ui": "node scripts/ui-regression.mjs",
    "test:covers": "node scripts/cover-preview-smoke.mjs",
    "test:settings": "node scripts/settings-smoke.mjs",
    "check:ui-deps": "node scripts/check-ui-deps.mjs",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "desktop": "electron .",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:reading-details": "node scripts/reader-details-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fastify/static": "10.1.7",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "fastify": "^5.6.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "4.14.8",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.0.0",
    "playwright-core": "^1.56.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "main": "desktop/main.cjs",
  "license": "MIT"
}
